# =============================================================
# Configuração de Ambiente — E-commerce Lakehouse
# =============================================================
# Copie este ficheiro para .env e preencha com os valores reais.
# NUNCA faça commit do ficheiro .env (já está no .gitignore).
#
# No Databricks, prefira Databricks Secrets em vez de .env:
#   dbutils.secrets.get(scope="aws", key="access_key_id")
#   dbutils.secrets.get(scope="aws", key="secret_access_key")
# =============================================================

# AWS S3 Configuration (Supabase S3-compatible storage)
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_REGION=eu-central-1
S3_ENDPOINT_URL=https://your-project.supabase.co/storage/v1/s3
S3_BUCKET=DataLakeEcommerce

# Databricks
DATABRICKS_WAREHOUSE_ID=your_warehouse_id
DATABRICKS_CATALOG=ecommerce
