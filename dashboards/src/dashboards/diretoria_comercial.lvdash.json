{
  "datasets": [
    {
      "name": "vendas_detalhadas",
      "displayName": "Vendas Detalhadas",
      "queryLines": [
        "SELECT\n",
        "  data,\n",
        "  dia_semana,\n",
        "  dia_semana_num,\n",
        "  hora,\n",
        "  canal_venda,\n",
        "  CASE\n",
        "    WHEN canal_venda = 'ecommerce' THEN 'E-commerce'\n",
        "    WHEN canal_venda = 'loja_fisica' THEN 'Loja física'\n",
        "  END AS canal,\n",
        "  categoria,\n",
        "  quantidade,\n",
        "  receita\n",
        "FROM\n",
        "  vendas_detalhadas"
      ],
      "columns": [
        {
          "displayName": "ticket_medio",
          "description": "Ticket médio = receita total dividido pelo número de vendas",
          "expression": "SUM(receita) / COUNT(*)"
        }
      ],
      "catalog": "ecommerce",
      "schema": "gold"
    },
    {
      "name": "receita_dia_semana",
      "displayName": "Receita Média por Dia da Semana",
      "queryLines": [
        "SELECT\n",
        "  dia_semana,\n",
        "  dia_semana_num,\n",
        "  data,\n",
        "  SUM(receita) AS receita_dia\n",
        "FROM\n",
        "  vendas_detalhadas\n",
        "GROUP BY\n",
        "  dia_semana,\n",
        "  dia_semana_num,\n",
        "  data"
      ],
      "catalog": "ecommerce",
      "schema": "gold"
    },
    {
      "name": "top_produtos",
      "displayName": "Top 10 Produtos",
      "queryLines": [
        "SELECT\n",
        "  id_produto,\n",
        "  nome_produto,\n",
        "  categoria,\n",
        "  SUM(receita) AS receita,\n",
        "  SUM(quantidade) AS itens_vendidos,\n",
        "  COUNT(*) AS total_vendas\n",
        "FROM\n",
        "  vendas_detalhadas\n",
        "GROUP BY\n",
        "  id_produto,\n",
        "  nome_produto,\n",
        "  categoria\n",
        "ORDER BY\n",
        "  receita DESC\n",
        "LIMIT 10"
      ],
      "catalog": "ecommerce",
      "schema": "gold"
    }
  ],
