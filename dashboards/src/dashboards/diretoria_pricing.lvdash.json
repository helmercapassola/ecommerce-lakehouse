{
  "datasets": [
    {
      "name": "mais_caros",
      "displayName": "Produtos Mais Caros (Top 20)",
      "queryLines": [
        "SELECT\n",
        "  id_produto,\n",
        "  nome_produto,\n",
        "  categoria,\n",
        "  marca,\n",
        "  nosso_preco,\n",
        "  preco_medio_concorrentes,\n",
        "  preco_maximo_concorrentes,\n",
        "  diferenca_pct_vs_media,\n",
        "  classificacao_preco,\n",
        "  receita,\n",
        "  itens_vendidos\n",
        "FROM\n",
        "  precos_competitividade\n",
        "WHERE\n",
        "  classificacao_preco = 'MAIS_CARO_QUE_TODOS'\n",
        "ORDER BY\n",
        "  receita DESC\n",
        "LIMIT 20"
      ],
      "catalog": "ecommerce",
      "schema": "gold"
    },
    {
      "name": "precos_competitividade",
      "displayName": "Preços e Competitividade",
      "queryLines": [
        "SELECT\n",
        "  *,\n",
        "  CASE\n",
        "    WHEN\n",
        "      classificacao_preco = 'MAIS_CARO_QUE_TODOS'\n",
        "      AND NOT possui_preco_suspeito\n",
        "    THEN\n",
        "      1\n",
        "    ELSE 0\n",
        "  END AS is_mais_caro_confirmado,\n",
        "  CASE\n",
        "    WHEN possui_preco_suspeito THEN 1\n",
        "    ELSE 0\n",
        "  END AS is_suspeito\n",
        "FROM\n",
        "  precos_competitividade"
      ],
      "catalog": "ecommerce",
      "schema": "gold"
    }
  ],
