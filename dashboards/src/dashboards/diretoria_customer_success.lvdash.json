{
  "datasets": [
    {
      "name": "clientes_segmentacao",
      "displayName": "Clientes Segmentação",
      "queryLines": [
        "SELECT\n",
        "  id_cliente,\n",
        "  nome_cliente,\n",
        "  estado,\n",
        "  nome_estado,\n",
        "  regiao,\n",
        "  total_compras,\n",
        "  receita,\n",
        "  ticket_medio,\n",
        "  primeira_compra,\n",
        "  ultima_compra,\n",
        "  segmento_cliente,\n",
        "  ranking_receita,\n",
        "  CASE\n",
        "    WHEN segmento_cliente = 'VIP' THEN 1\n",
        "    ELSE 0\n",
        "  END AS is_vip,\n",
        "  CASE\n",
        "    WHEN segmento_cliente = 'VIP' THEN receita\n",
        "    ELSE 0\n",
        "  END AS receita_vip,\n",
        "  SUM(\n",
        "    CASE\n",
        "      WHEN segmento_cliente = 'VIP' THEN receita\n",
        "      ELSE 0\n",
        "    END\n",
        "  ) OVER ()\n",
        "    * 1.0\n",
        "    / NULLIF(SUM(receita) OVER (), 0) AS pct_receita_vip\n",
        "FROM\n",
        "  clientes_segmentacao"
      ],
      "catalog": "ecommerce",
      "schema": "gold"
    },
    {
      "name": "top_clientes",
      "displayName": "Top 20 Clientes por Receita",
      "queryLines": [
        "SELECT\n",
        "  ranking_receita,\n",
        "  nome_cliente,\n",
        "  segmento_cliente,\n",
        "  regiao,\n",
        "  total_compras,\n",
        "  receita,\n",
        "  ticket_medio\n",
        "FROM\n",
        "  clientes_segmentacao\n",
        "ORDER BY\n",
        "  receita DESC\n",
        "LIMIT 20"
      ],
      "catalog": "ecommerce",
      "schema": "gold"
    }
  ],
